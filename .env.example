# Paste the Sandbox app Client ID and Secret from your PayPal Developer Dashboard.
# Keep the Secret private. Do not commit your personal .env file.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Set your real store/seller details before enabling checkout.
STORE_LEGAL_NAME=
STORE_SUPPORT_EMAIL=
STORE_POSTAL_ADDRESS=
STORE_SHIPPING_POLICY=
STORE_RETURNS_POLICY=
STORE_TAX_DISCLOSURE=
STORE_POLICY_EFFECTIVE_DATE=
STORE_LIVE_COMPLIANCE_CONFIRMED=false

# Optional flat shipping fee in cents (500 = $5.00).
PAYPAL_SHIPPING_CENTS=0
